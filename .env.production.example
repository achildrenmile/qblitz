# Server SSH connection
SYNOLOGY_HOST=straliadmin@station.strali.solutions

# Remote directory on the server
REMOTE_DIR=/volume1/docker/qblitz

# Docker container settings
CONTAINER_NAME=qblitz
IMAGE_NAME=qblitz:latest
CONTAINER_PORT=3412:80

# Public URL for health check
SITE_URL=https://qblitz.oeradio.at/

# Docker path (default for Synology DSM)
DOCKER_CMD=/var/packages/Docker/target/usr/bin/docker
